{
  "name": "Private Session Manager",
  "description": "Telegram session management platform",
  "env": {
    "API_ID": { "description": "Telegram API ID from my.telegram.org", "required": true },
    "API_HASH": { "description": "Telegram API HASH", "required": true },
    "BOT_TOKEN": { "description": "Bot token from @BotFather", "required": true },
    "PLATFORM_NAME": { "value": "Private Session Manager", "required": false },
    "MAX_CONCURRENCY": { "value": "2", "required": false },
    "GLOBAL_MAX_CONNECTIONS": { "value": "25", "required": false },
    "DATA_DIR": { "value": "accstore_data", "required": false }
  },
  "formation": { "web": { "quantity": 1, "size": "basic" } },
  "buildpacks": [ { "url": "heroku/python" } ]
}
